{
  "name": "epub-web",
  "image": "ghcr.io/publira/base-images/publira-dev:2026.08.30-11@sha256:beff4d709ddda7905bc6e37dc7bc65e5969fafece05b4a7003ed7766806c4b19",
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0.5": {},
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.0": {
      "moby": false,
      "version": "29.3.1"
    }
  },
  "mounts": [
    "source=epub-web-claude-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=epub-web-codex-${devcontainerId},target=/home/vscode/.codex,type=volume",
    "source=epub-web-gemini-${devcontainerId},target=/home/vscode/.gemini,type=volume",
    "source=epub-web-gh-${devcontainerId},target=/home/vscode/.config/gh,type=volume",
    "source=epub-web-grok-${devcontainerId},target=/home/vscode/.grok,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": ["bradlc.vscode-tailwindcss", "golang.go", "oxc.oxc-vscode"]
    }
  },
  "postCreateCommand": ".devcontainer/post-create.sh"
}
